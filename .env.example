# MongoDB Configuration
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/chatify?retryWrites=true&w=majority

# JWT Secret
JWT_PASS=your_super_secret_jwt_key

# Firebase Cloud Messaging (FCM)
# Base64 encoded Firebase Service Account JSON
FIREBASE_SERVICE_KEY=your_base64_encoded_firebase_adminsdk_json

# 100ms Video / Audio Calling Configuration
APP_ACCESS_KEY=your_100ms_app_access_key
APP_SECRET=your_100ms_app_secret
TEMPLATE_ID=your_100ms_room_template_id

# Google AI (Gemini)
GOOGLE_GEMINI_API=your_google_gemini_api_key
